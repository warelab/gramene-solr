# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# Commenting this out is preferred by some people, see
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git-
node_modules

# Users Environment Variables
.lock-wscript

# Python bytecode (expression_pipeline)
__pycache__/
*.pyc

# Generated build artifacts — never commit (rebuilt by the pipeline from mongo/solr).
# Genes-core load files (solr_genes.json is ~25GB):
/genes/solr_genes.json
/genes/solr_genes.attribs.json
/genes/*_table.txt
/genes/*_attrib_table.txt
/genes/attr_*.tsv
/genes/*.ndjson
/genes/baseline_name_lut.json
# Suggestion json (faceted from the genes core):
/suggestions/*.json
# Expression-attribute pipeline outputs (regenerated by expression_pipeline/build.py):
/expression_pipeline/*.assays_cache.json
/expression_pipeline/ref_*.json
/expression_pipeline/inv_*.json
/expression_pipeline/prog_*.json
/expression_pipeline/expression_panel.json
/expression_pipeline/*_attributes.jsonl
/expression_pipeline/*_attributes.tsv
